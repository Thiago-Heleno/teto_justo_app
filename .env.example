# Copie este arquivo para ".env" e preencha com os valores do seu projeto Supabase
# (Project Settings > API, no painel do Supabase).

SUPABASE_URL=
SUPABASE_KEY=

# Redis compartilhado para limitar tentativas de login. No Docker Compose,
# use redis://redis:6379/0; fora dele, use a URL protegida do seu Redis.
REDIS_URL=

# Convites para entrar em uma casa: gere localmente com
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# Configure ao menos 32 bytes aleatórios; não versione o valor.
# Também assina os códigos de verificação de e-mail do cadastro.
CASA_CONVITE_SECRET=

# Vercel Cron: configure em Production no projeto do backend; não versione o valor.
CRON_SECRET=

# Chamada manual POST de penalidades: token privado opcional; não versione o valor.
PENALIDADE_JOB_TOKEN=

# Chamada manual POST de rotatividade: token privado opcional; não versione o valor.
ROTATIVIDADE_JOB_TOKEN=

# Resend (envio de emails): chave criada no painel do Resend; não versione o valor.
RESEND_API=

# Remetente opcional. Sem valor, usa onboarding@resend.dev, que só entrega para o
# email da conta Resend até você verificar um domínio no painel.
RESEND_FROM=
