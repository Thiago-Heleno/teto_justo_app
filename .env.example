# Copie este arquivo para ".env" e preencha com os valores do seu projeto Supabase
# (Project Settings > API, no painel do Supabase).

SUPABASE_URL=
SUPABASE_KEY=

# Convites para entrar em uma casa: gere localmente com
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# Configure ao menos 32 bytes aleatórios; não versione o valor.
CASA_CONVITE_SECRET=

# Desenvolvimento local: gere um token privado; não versione o valor.
# Em ambiente compartilhado, configure o mesmo segredo no backend e no agendador.
PENALIDADE_JOB_TOKEN=

# Token privado do job de rotatividade automática; não versione o valor.
ROTATIVIDADE_JOB_TOKEN=
